	<queryString language="SQL">
		<![CDATA[SELECT p.id_paket, p.nama_paket, p.speed, p.harga,
(SELECT COUNT(*) FROM langganan l WHERE l.nama_paket = p.nama_paket) AS pelanggan
FROM paket p
ORDER BY p.id_paket ASC]]>
	</queryString>
