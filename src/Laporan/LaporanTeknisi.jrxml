<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="700" pageHeight="842" columnWidth="660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f2dc0ea1-7618-4399-a90f-fd9f88c1b3e7">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_STATUS" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    t.nama AS nama_teknisi,
    t.spesialis,
    (SELECT COUNT(*) FROM tiket tk WHERE tk.id_teknisi = t.id_teknisi) AS tiket_ditangani,
    (SELECT COUNT(*) FROM tiket tk WHERE tk.id_teknisi = t.id_teknisi AND tk.status = 'Selesai') AS tiket_selesai,
    t.status
FROM teknisi t
WHERE $P{P_STATUS} = 'Semua' OR t.status = $P{P_STATUS}
ORDER BY t.nama ASC]]>
	</queryString>
	<field name="nama_teknisi" class="java.lang.String"/>
	<field name="spesialis" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tiket_ditangani" class="java.lang.Long"/>
	<field name="tiket_selesai" class="java.lang.Long"/>
	<field name="status" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="total_teknisi" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
	</variable>
	<variable name="total_tiket" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{tiket_ditangani}]]></variableExpression>
	</variable>
	<variable name="total_aktif" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{tiket_selesai}]]></variableExpression>
	</variable>
