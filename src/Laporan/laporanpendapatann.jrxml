	<parameter name="P_NAMA_BULAN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    id_transaksi,
    nama_pel,
    paket,
    harga,
    tgl_bayar,
    metode,
    status,
    admin
FROM transaksi
WHERE status = 'Lunas'
  AND MONTH(tgl_bayar) = $P{P_BULAN}
ORDER BY tgl_bayar ASC]]>
	</queryString>
